{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wenart.run/schema/building.schema.json",
  "title": "WenArt building model",
  "description": "One merged building model per project. Every element carries evidence. Units: metres, degrees. Coordinates: building-local XY, Z up; each level has its own elevation.",
  "type": "object",
  "required": ["schema_version", "project", "status", "documents", "levels", "walls", "openings", "rooms", "furniture", "conflicts", "unverified", "warnings"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "project": {
      "type": "object",
      "required": ["id", "source_folder", "created_utc", "pipeline_commit"],
      "properties": {
        "id": {"type": "string"},
        "source_folder": {"type": "string"},
        "created_utc": {"type": "string", "format": "date-time"},
        "pipeline_commit": {"type": "string"},
        "brief": {"type": "object", "description": "Parsed brief.yaml or defaults"},
        "unit_system": {"enum": ["imperial", "metric"], "description": "The unit system of the master pages (docs/milestone7.md §1.1); reports show imperial projects in feet-inches with metres"}
      }
    },
    "status": {"enum": ["ok", "needs_review"], "description": "needs_review = something critical is missing (scale, closed outer walls). The pipeline stops after the report."},
    "documents": {"type": "array", "items": {"$ref": "#/$defs/document"}},
    "levels": {"type": "array", "items": {"$ref": "#/$defs/level"}},
    "walls": {"type": "array", "items": {"$ref": "#/$defs/wall"}},
    "openings": {"type": "array", "items": {"$ref": "#/$defs/opening"}},
    "rooms": {"type": "array", "items": {"$ref": "#/$defs/room"}},
    "furniture": {"type": "array", "items": {"$ref": "#/$defs/furniture"}},
    "conflicts": {"type": "array", "items": {"$ref": "#/$defs/conflict"}},
    "unverified": {"type": "array", "items": {"type": "string"}, "description": "IDs of elements with status=unverified (copied here for the report)"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "site": {"type": ["object", "null"], "description": "Plot elements outside the building (docs/milestone7.md §1.3, §2.5): recorded and reported, never built in 3D", "properties": {
      "boundary_walls": {"type": "array", "items": {"type": "object", "required": ["id", "start", "end", "thickness", "evidence", "kind"], "properties": {
        "id": {"type": "string", "description": "sw_<level>_<n>"},
        "level_id": {"type": "string"},
        "start": {"$ref": "#/$defs/point"},
        "end": {"$ref": "#/$defs/point"},
        "thickness": {"type": "number"},
        "kind": {"enum": ["plot", "other"], "description": "plot = a wall component whose convex hull holds the building (compound wall); other = any other wall without room labels"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      }}},
      "areas": {"type": "array", "items": {"type": "object", "required": ["id", "label", "polygon", "evidence"], "properties": {
        "id": {"type": ["string", "null"], "description": "sa_<level>_<slug>"},
        "level_id": {"type": "string"},
        "label": {"type": "string", "description": "Exterior label as printed: Parking, Garden, ..."},
        "label_raw": {"type": ["string", "null"]},
        "label_size": {"$ref": "#/$defs/label_size"},
        "polygon": {"type": ["array", "null"], "items": {"$ref": "#/$defs/point"}, "description": "null unless a closed face exists"},
        "extent_m": {"type": "array", "items": {"type": "number"}, "description": "Open extent around the label (x, y) to the nearest wall or the plot hull, metres"},
        "anchor": {"$ref": "#/$defs/point"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      }}},
      "decor": {"type": "array", "items": {"type": "object", "required": ["id", "kind", "center", "size", "evidence"], "properties": {
        "id": {"type": ["string", "null"], "description": "sd_<level>_<n>"},
        "level_id": {"type": "string"},
        "kind": {"enum": ["plant", "tree", "car", "other"]},
        "center": {"$ref": "#/$defs/point"},
        "size": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      }}},
      "openings": {"type": "array", "items": {"type": "object", "description": "Doors, windows and gaps in site boundary walls"}}
    }}
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "description": "Where this fact comes from. At least one evidence entry per element.",
      "required": ["file", "method", "confidence"],
      "properties": {
        "file": {"type": "string", "description": "Path relative to the project folder"},
        "page": {"type": ["integer", "null"], "description": "1-based page for PDFs; null for DXF/images"},
        "layer": {"type": ["string", "null"], "description": "DXF layer name, e.g. DUVAR, KAPI, MOBILYA"},
        "entity": {"type": ["string", "null"], "description": "DXF entity handle or PDF path index, e.g. INSERT:1F3A"},
        "block": {"type": ["string", "null"], "description": "DXF block name for INSERTs"},
        "pixel_box": {"type": ["array", "null"], "items": {"type": "number"}, "minItems": 4, "maxItems": 4, "description": "[x0,y0,x1,y1] in page pixels at the recorded dpi"},
        "dpi": {"type": ["number", "null"]},
        "method": {"enum": ["vector", "raster", "ocr", "ai", "derived"], "description": "Trust order: vector > raster/ocr > ai. raster = deterministic image processing of a scan or photo (docs/milestone7.md). derived = computed from other verified elements (e.g. room polygon from walls)."},
        "model": {"type": ["string", "null"], "description": "Model ID for ocr/ai methods"},
        "pass": {"type": ["integer", "null"], "description": "AI pass number (1 or 2) for two-pass agreement"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "text": {"type": ["string", "null"], "description": "Raw text read, e.g. 'Salon 24,50 m²' or '3,45'"}
      }
    },
    "point": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
    "document": {
      "type": "object",
      "required": ["id", "file", "format", "pages"],
      "properties": {
        "id": {"type": "string"},
        "file": {"type": "string"},
        "format": {"enum": ["dwg", "dxf", "pdf", "image"]},
        "converter": {"type": ["string", "null"], "description": "e.g. libredwg dwg2dxf 0.14 d9468ae; audit: 0 errors, 0 fixes"},
        "conversion": {"type": "object", "description": "DWG only: LibreDWG version, $ACADVER of the source, model-space entity counts, audit (docs/milestone7.md §5.1)"},
        "unit_system": {"enum": ["imperial", "metric"], "description": "Majority of the document's parsed lengths (docs/milestone7.md §1.1)"},
        "source_kind": {"type": ["string", "null"], "enum": ["cad_pdf", "dxf", "raster_scan", "raster_photo", null], "description": "How the document was read (generic page model, docs/milestone7.md §1.2)"},
        "pages": {"type": "array", "items": {
          "type": "object",
          "required": ["page", "class", "kind", "confidence"],
          "properties": {
            "page": {"type": "integer"},
            "class": {"enum": ["floor_plan", "furniture_plan", "section", "elevation", "site_plan", "detail", "photo_of_plan", "photo_of_room", "other"]},
            "skip_reason": {"type": ["string", "null"]},
            "kind": {"enum": ["vector", "scan", "photo"]},
            "level_id": {"type": ["string", "null"]},
            "level_label_raw": {"type": ["string", "null"], "description": "e.g. 'ZEMİN KAT PLANI'"},
            "classifier": {"type": ["string", "null"], "description": "Which rule classified the page: title | generic_labels (room-name labels + a wall structure, docs/milestone7.md §2.1) | ocr"},
            "rectified_image": {"type": ["string", "null"], "description": "Raster pages: the rectified image under the output folder"},
            "to_original": {"type": ["array", "null"], "description": "Raster pages: 3x3 matrix, page units -> original image pixels"},
            "scale": {"type": ["object", "null"], "properties": {
              "metres_per_unit": {"type": "number"},
              "method": {"enum": ["dxf_insunits", "pdf_scale_text", "dimension_text", "area_label", "fallback_door_width", "room_size_label"]},
              "confidence": {"type": "number"},
              "evidence": {"$ref": "#/$defs/evidence"}
            }},
            "transform_to_building": {"type": ["array", "null"], "items": {"type": "number"}, "minItems": 6, "maxItems": 6, "description": "Affine [a,b,c,d,e,f] mapping page/model coords to building coords"},
            "confidence": {"type": "number"},
            "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
            "debug_image": {"type": ["string", "null"]}
          }
        }}
      }
    },
    "level": {
      "type": "object",
      "required": ["id", "label", "elevation", "ceiling_height", "ceiling_height_source"],
      "properties": {
        "id": {"type": "string"},
        "label": {"type": "string", "description": "Normalised: Bodrum Kat, Zemin Kat, 1. Kat, Çatı Katı ..."},
        "order": {"type": "integer"},
        "elevation": {"type": "number"},
        "ceiling_height": {"type": "number"},
        "ceiling_height_source": {"enum": ["section", "elevation_drawing", "assumed_default"]},
        "label_source": {"enum": ["title", "assumed"], "description": "assumed = no level title on the only plan page: L0 Ground floor (docs/milestone7.md §2.1); evidence = the room labels"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "wall": {
      "type": "object",
      "required": ["id", "level_id", "start", "end", "thickness", "status", "evidence"],
      "properties": {
        "id": {"type": "string"},
        "level_id": {"type": "string"},
        "start": {"$ref": "#/$defs/point"},
        "end": {"$ref": "#/$defs/point"},
        "thickness": {"type": "number"},
        "height": {"type": ["number", "null"]},
        "exterior": {"type": "boolean"},
        "status": {"enum": ["verified", "unverified"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "opening": {
      "type": "object",
      "required": ["id", "type", "level_id", "wall_id", "center", "width", "status", "evidence"],
      "properties": {
        "id": {"type": "string"},
        "type": {"enum": ["door", "window", "opening"]},
        "level_id": {"type": "string"},
        "wall_id": {"type": ["string", "null"], "description": "null only for a virtual separator (virtual: true, docs/milestone7.md §2.7.1)"},
        "virtual": {"type": "boolean", "description": "true = a separator line between two rooms where no wall exists (type opening, wall_id null)"},
        "line": {"type": ["array", "null"], "items": {"$ref": "#/$defs/point"}, "minItems": 2, "maxItems": 2, "description": "Separator line [[x,y],[x,y]] of a virtual separator"},
        "center": {"$ref": "#/$defs/point"},
        "width": {"type": "number"},
        "height": {"type": ["number", "null"]},
        "sill_height": {"type": ["number", "null"]},
        "assumed": {"type": "array", "items": {"enum": ["height", "sill_height"]}, "description": "Values that are defaults, not drawn (door and doorless height 2.10 m, window sill 0.90 m and height 1.20 m)"},
        "type_raw": {"type": ["string", "null"], "description": "e.g. 'unclassified gap content' for a gap whose strokes are no door, window or empty gap"},
        "swing_side": {"type": ["string", "null"], "description": "Room id the door opens into, if drawn"},
        "status": {"enum": ["verified", "unverified"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "room": {
      "type": "object",
      "required": ["id", "level_id", "label", "polygon", "area_computed", "has_documented_furniture", "status", "evidence"],
      "properties": {
        "id": {"type": "string"},
        "level_id": {"type": "string"},
        "label": {"type": "string", "description": "Normalised Turkish label, e.g. Salon, Yatak Odası, Mutfak, Banyo, Balkon"},
        "label_raw": {"type": ["string", "null"]},
        "room_type": {"enum": ["living", "dining", "bedroom", "kitchen", "bathroom", "wc", "hall", "balcony", "storage", "prayer", "other", "unknown"]},
        "polygon": {"type": "array", "items": {"$ref": "#/$defs/point"}, "minItems": 3},
        "area_computed": {"type": "number"},
        "area_label": {"type": ["number", "null"], "description": "Area read from the drawing in m², e.g. 24.5 from 'Salon 24,50 m²' (sq ft converted)"},
        "label_size": {"$ref": "#/$defs/label_size"},
        "has_documented_furniture": {"type": "boolean"},
        "style_override": {"type": ["string", "null"]},
        "status": {"enum": ["verified", "unverified"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "furniture": {
      "type": "object",
      "required": ["id", "level_id", "room_id", "type", "source", "footprint", "status", "evidence"],
      "properties": {
        "id": {"type": "string"},
        "level_id": {"type": "string"},
        "room_id": {"type": ["string", "null"]},
        "type": {"enum": ["bed_single", "bed_double", "sofa", "armchair", "table_dining", "table_coffee", "desk", "chair", "wardrobe", "kitchen_counter", "kitchen_island", "fridge", "stove", "sink_kitchen", "washbasin", "toilet", "shower", "bathtub", "tv_unit", "bookshelf", "nightstand", "dresser", "washing_machine", "stair", "side_table", "floor_lamp", "potted_plant", "unknown"]},
        "type_raw": {"type": ["string", "null"], "description": "Block name or label as drawn, e.g. KANEPE_3LU, yatak"},
        "type_method": {"enum": ["block_name", "rule", "ai_two_pass", "none"], "description": "How the type was decided (generic core, docs/milestone7.md §2.8, §3.3)"},
        "type_candidates": {"type": "array", "items": {"type": "object"}, "description": "The AI passes' answers: {type, model, pass, confidence, front, reason}"},
        "build": {"type": "boolean", "description": "false = a drawn symbol both AI passes call not_furniture: kept as an obstacle, not built (default true)"},
        "assumed": {"type": "array", "items": {"enum": ["front_deg"]}, "description": "Values that are assumed, not decided: front_deg = the drawn front kept although both AI passes answered 'none' (review ingest-6)"},
        "stair": {"type": "object", "description": "Stair rule result: flights [{start, end, width, lines, spacing}], landing, direction, *_assumed, riser_m, riser_source", "properties": {
          "flights": {"type": "array", "items": {"type": "object", "properties": {"start": {"$ref": "#/$defs/point"}, "end": {"$ref": "#/$defs/point"}, "width": {"type": "number"}, "lines": {"type": "integer"}, "spacing": {"type": "number", "description": "Distance between the drawn tread lines, metres"}}}},
          "landing": {"type": ["object", "null"], "properties": {"polygon": {"type": "array", "items": {"$ref": "#/$defs/point"}}, "depth": {"type": "number"}}},
          "direction": {"type": ["array", "null"]},
          "direction_assumed": {"type": "boolean"},
          "turn": {"enum": ["straight", "U", "other"]},
          "turn_assumed": {"type": "boolean"},
          "void_assumed": {"type": "boolean"},
          "riser_m": {"type": ["number", "null"]},
          "riser_source": {"type": ["string", "null"]},
          "reason": {"type": "string", "description": "Why direction and turn are assumed"}
        }},
        "shape": {"enum": ["round"], "description": "round = a circle fits >= 90 % of the drawn outline (docs/milestone7.md §6.4: a round side table); absent = the footprint rectangle"},
        "circle_fit": {"type": "object", "description": "The circle fitted to the drawn outline: share of the outline on it, radius in metres", "properties": {
          "share": {"type": "number"},
          "radius": {"type": "number"}
        }},
        "counter_run": {"type": "object", "description": "Kitchen counter rule: the wall the run stands against and its strokes", "properties": {
          "wall_id": {"type": ["string", "null"]},
          "strokes": {"type": "array", "items": {"type": "string"}}
        }},
        "source": {"enum": ["from_documents", "added_by_ai"]},
        "footprint": {
          "type": "object",
          "required": ["center", "size", "rotation_deg"],
          "properties": {
            "center": {"$ref": "#/$defs/point"},
            "size": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2, "description": "[width, depth] in metres, in the piece's own frame"},
            "rotation_deg": {"type": "number", "description": "Rotation of the footprint around +Z"}
          }
        },
        "front_deg": {"type": ["number", "null"], "description": "Direction the piece faces (e.g. away from a bed headboard, out of a sofa back). null = not determinable"},
        "height": {"type": ["number", "null"]},
        "asset": {"type": ["object", "null"], "description": "Chosen 3D asset: library, id, license, fit scale", "properties": {
          "library": {"type": "string"}, "asset_id": {"type": "string"}, "license": {"type": "string"}, "fit_scale": {"type": "array", "items": {"type": "number"}}
        }},
        "status": {"enum": ["verified", "unverified"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "label_size": {
      "type": ["object", "null"],
      "description": "A printed room size vs the face's clear size (docs/milestone7.md §2.7.3): ok within max(5 %, 0.15 m) per side, conflict beyond, unchecked for a face that is not rectangular (then w x l vs the face area at 8 %)",
      "required": ["text", "status"],
      "properties": {
        "text": {"type": "string"},
        "width_m": {"type": ["number", "null"]},
        "length_m": {"type": ["number", "null"]},
        "measured": {"type": ["array", "null"], "items": {"type": "number"}},
        "status": {"enum": ["ok", "conflict", "unchecked"]},
        "off_pct": {"type": "array", "items": {"type": "number"}},
        "unverified": {"type": "boolean", "description": "true = the size differs enough to mark the room unverified (over 10 % per side, or the area rule)"},
        "area_m2": {"type": "object", "description": "Faces that are not rectangular: w x l of the label vs the face area", "properties": {
          "label": {"type": "number"},
          "face": {"type": "number"}
        }}
      }
    },
    "conflict": {
      "type": "object",
      "required": ["id", "kind", "element_ids", "description", "resolution"],
      "properties": {
        "id": {"type": "string"},
        "kind": {"enum": ["dimension_vs_measured", "area_label_vs_computed", "count_mismatch", "outline_mismatch", "type_disagreement", "scale_disagreement", "label_size_mismatch", "symbol_type_disagreement", "raster_count_mismatch", "other"]},
        "element_ids": {"type": "array", "items": {"type": "string"}},
        "description": {"type": "string"},
        "resolution": {"type": "string", "description": "Which source won (DWG > vector PDF > scan > photo) or 'unresolved'"}
      }
    }
  }
}
