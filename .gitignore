# Secrets and local config - never commit
.env
.env.*
*.pem
*.key
secrets/

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/

# Large or generated outputs (full-size outputs live on the RunPod Network Volume)
outputs/
*.blend1
*.exr
*.hdr
*.safetensors
*.ckpt
*.pt
*.bin
projects/*/outputs/
results/**/*.png
# Milestone 9 3D files (results/final/<p>/3d/): the runner collects them into runs/<job>/, the full files stay on
# the Network Volume (outputs/<p>/export/); only export_manifest.json is committed
results/**/*.blend
results/**/*.glb
!results/**/*.jpg
!results/**/*.jpeg

# OS / editor
.DS_Store
.idea/
.vscode/
*.log
logs/
runs/

# Claude Code worktrees used by review/fix agents
.claude/worktrees/

# Downloaded CC0 textures and HDRIs (manifest.json records them; pod: /workspace/assets)
/assets/

# Private projects (docs/milestone6.md §7, docs/intake.md): never committed. The repo is public;
# private uploads, outputs and results live on the network volume, collected into runs/.
/projects-private/
/results-private/
/outputs-private/
